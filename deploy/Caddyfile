# agentlink server: the relay plus the install script, reachable two ways:
# - through a Cloudflare Tunnel (cloudflared → http://127.0.0.1:8080), e.g. agentlink.agent7.dev
# - directly with automatic Let's Encrypt TLS on AGENTLINK_HOST, e.g. 116-203-46-74.sslip.io
{
	servers {
		# cloudflared and Caddy run on this machine; keep the client address they forward.
		trusted_proxies static private_ranges
	}
}

(agentlink) {
	encode gzip

	# curl -fsSL https://<host>/install.sh | sh
	handle /install.sh {
		root * /srv/agentlink
		header Content-Type "text/x-shellscript; charset=utf-8"
		file_server
	}

	# Setup instructions for AI agents: "follow https://<host>/llms.txt".
	handle /llms.txt {
		root * /srv/agentlink
		header Content-Type "text/plain; charset=utf-8"
		file_server
	}

	# The package the install script downloads (and its checksum).
	handle /dl/* {
		root * /srv/agentlink
		file_server
	}

	# Everything else is the relay (WebSocket upgrades and /health).
	handle {
		reverse_proxy 127.0.0.1:7700
	}
}

# Cloudflare Tunnel origin (plain HTTP, localhost only; Cloudflare terminates TLS).
http://:8080 {
	bind 127.0.0.1
	import agentlink
}

{$AGENTLINK_HOST} {
	import agentlink
}
